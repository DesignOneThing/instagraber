TELEGRAM_BOT_TOKEN=123456:replace_me

# Optional. Instagram often asks for login/cookies.
# Export cookies from your browser in Netscape format and put the path here.
# INSTAGRAM_COOKIES_FILE=/absolute/path/to/instagram_cookies.txt

# Optional for Render. Paste Netscape cookies content as a secret env var.
# INSTAGRAM_COOKIES_TEXT=# Netscape HTTP Cookie File

# Optional limits, in megabytes.
MAX_UPLOAD_MB=49
MAX_DOWNLOAD_MB=250
